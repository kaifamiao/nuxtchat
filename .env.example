# OpenAI API 密钥（必填）
OPENAI_API_KEY=sk-your-api-key-here

# API 代理地址（可选，使用代理时填写）
# BASE_URL=https://api.openai-proxy.com/v1

# 页面访问密码（可选，建议设置以防滥用）
# CODE=your-access-password

# 隐藏用户 API Key 输入框（可选，设为 1 禁止用户自行填入）
# HIDE_USER_API_KEY=1

# 禁用 GPT-4（可选，设为 1 禁用）
# DISABLE_GPT4=1

# 自定义模型列表（可选）
# CUSTOM_MODELS=gpt-4o,gpt-4o-mini,-gpt-3.5-turbo

# 默认模型（可选）
# DEFAULT_MODEL=gpt-4o
